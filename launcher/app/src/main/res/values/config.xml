<?xml version="1.0" encoding="utf-8"?>
<!--
  Home screen settings. Edit, then run ./build-and-install.sh from the tv-launcher folder.
-->
<resources>
    <!-- Dock: exactly four package names, left to right. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>in.startv.hotstar</item>
        <item>com.google.android.youtube.tv</item>
    </string-array>

    <!-- Apps never shown in the grid (package names). -->
    <string-array name="hidden_apps">
        <item>com.sony.dtv.ecodashboard</item>
        <item>com.sony.dtv.timers</item>
        <item>com.sony.dtv.notificationcenter</item>   <!-- BRAVIA notifications -->
        <item>com.sony.dtv.smartmediaapp</item>       <!-- Media Player (USB drive; VLC plays those files too) -->
        <item>com.sony.dtv.tvx</item>                 <!-- TV (use the Inputs pill instead) -->
        <item>com.sony.dtv.seeds.iot</item>           <!-- TV Control with Smart Speakers (keeps working) -->
    </string-array>

    <!-- Colour remote buttons: package to open. Leave empty to let the key pass through. -->
    <string name="key_red">org.videolan.vlc</string>
    <string name="key_green">in.startv.hotstar</string>
    <string name="key_yellow">com.apple.atve.sony.appletv</string>
    <string name="key_blue">com.sonyliv</string>

    <!-- While any of these apps is on screen, the colour buttons are left alone
         (Live TV / HDMI / tuner, HbbTV and teletext use them). -->
    <string-array name="color_key_passthrough">
        <item>com.sony.dtv.tvx</item>
        <item>com.sony.dtv.tvinput.tuner</item>
        <item>com.sony.dtv.tvinput.external</item>
        <item>com.sony.dtv.hbbtvplayer</item>
        <item>com.vewd.core.service</item>
        <item>com.vewd.core.integration.dia</item>
    </string-array>

    <!-- Weather: Open-Meteo, no API key. Set to your own location's coordinates
         (e.g. search "<your city> latitude longitude"). Default below is Null Island (0,0). -->
    <string name="weather_lat">0.0</string>
    <string name="weather_lon">0.0</string>
    <integer name="weather_refresh_minutes">30</integer>
    <!-- Older than this, the weather row is shown dimmed. -->
    <integer name="weather_stale_minutes">90</integer>

    <!-- Live cricket (CricketData.org, free plan = 100 requests a day). The API key goes in
         launcher/local.properties as  cricket.apiKey=...  (kept out of git). No key = no score row.
         Shows India men's matches and IPL; refreshes only while the home screen is on screen. -->
    <bool name="cricket_enabled">true</bool>
    <!-- Also show India Women's matches. -->
    <bool name="cricket_india_women">false</bool>
    <integer name="cricket_live_refresh_minutes">4</integer>
    <integer name="cricket_idle_refresh_minutes">30</integer>
    <!-- On the screensaver (which can run for hours) the live score refreshes a bit slower. -->
    <integer name="screensaver_cricket_refresh_minutes">5</integer>

    <!-- Screensaver: while an India/IPL match is live, a small score card sits above Google's
         ambient-mode clock (bottom right) on top of the photo screensaver. Nothing otherwise.
         screensaver_clock=true instead draws our own big clock + date bottom-left (turn ambient
         mode's own clock off then, in its settings). -->
    <bool name="screensaver_overlay">true</bool>
    <bool name="screensaver_clock">false</bool>

    <!-- Arcade touches: a chomper that runs along the top of the dock to the selected app, eating
         dots, and a little ghost next to the weather. Your app banners stay as they are. -->
    <bool name="arcade_touches">false</bool>

    <!-- Kids mode: a "Kids" pill on the home screen switches to a kids-only screen with just these
         apps (first four in the dock). Any other app, Settings, inputs or the Play Store that comes
         to the front is sent straight back. Leaving needs kids_pin (exactly 4 digits).
         kids_pin empty = feature hidden. Set your PIN in config.json, never here (public repo). -->
    <string-array name="kids_apps">
        <item>com.google.android.youtube.tvkids</item>
        <item>com.netflix.ninja</item>
        <item>in.startv.hotstar</item>
        <item>com.amazon.amazonvideo.livingroom</item>
    </string-array>
    <string name="kids_pin"></string>
    <!-- Optional: shown as "Hi <name>!" on the kids screen. -->
    <string name="kids_name"></string>

    <!-- Wallpapers: JPG/PNG files in
         /sdcard/Android/data/com.udesh.tvhome/files/wallpapers/
         rotate in name order, changing at most every wallpaper_rotate_hours, and only when
         the home screen comes back on screen. A single files/wallpaper.jpg is used if the
         folder is empty. No files = pitch black. See README. -->
    <string name="wallpaper_file">wallpaper.jpg</string>
    <string name="wallpaper_dir">wallpapers</string>
    <integer name="wallpaper_rotate_hours">3</integer>

    <!-- Remote "Apps" button opens the home screen on the app grid (pressing it again goes back to the dock). -->
    <bool name="apps_button_opens_grid">true</bool>

    <!-- Wake the HDMI-ARC soundbar when an app opens or something starts playing, if it went to
         standby on its own. Uses Sony's Home Theatre Control panel for ~2 s, then closes it. -->
    <bool name="soundbar_wake">true</bool>
</resources>
